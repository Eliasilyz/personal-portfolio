{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow, max-image-preview:large, max-snippet:-1"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.farelhanafi.my.id"
        }
      ],
      "destination": "https://farelhanafi.my.id/:path*",
      "permanent": true
    }
  ]
}
